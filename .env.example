# Staging defaults are intentionally safe.
NEXT_PUBLIC_SITE_LIVE=false
# First use `npm run media:sync` and approve the actual files before setting true.
NEXT_PUBLIC_LOCAL_MEDIA=false

# Keep both cutover switches off until Horsehead's inventory and connections are verified.
NEXT_PUBLIC_HORSEHEAD_AUTOMATION_LIVE=false
HORSEHEAD_SEND_MODE=shadow
HORSEHEAD_PUBLIC_URL=https://horseheadlakelodge.com
DATABASE_URL=
CRON_SECRET=
HORSEHEAD_STAFF_SECRET=
HORSEHEAD_STAFF_EMAIL=
HORSEHEAD_OFFER_SECRET=
HORSEHEAD_RECEIPT_SECRET=
HORSEHEAD_FOLLOWUP_DAYS=1,4,11

# The inquiry folder receives approved mailbox rules for venue business inquiries and replies.
HORSEHEAD_GRAPH_TENANT_ID=
HORSEHEAD_GRAPH_CLIENT_ID=
HORSEHEAD_GRAPH_CLIENT_SECRET=
HORSEHEAD_GRAPH_MAILBOX=
HORSEHEAD_GRAPH_INQUIRY_FOLDER_ID=
HORSEHEAD_GRAPH_CALENDAR_ID=
HORSEHEAD_INBOX_START_AT=
HORSEHEAD_WEDDINGWIRE_SENDERS=
HORSEHEAD_THE_KNOT_SENDERS=
HORSEHEAD_EVENTECTIVE_SENDERS=

# Optional OpenAI inquiry classification.
OPENAI_API_KEY=
HORSEHEAD_OPENAI_MODEL=
